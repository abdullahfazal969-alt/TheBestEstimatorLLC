# Copy this file to .env and fill in real values.
# NEVER commit the actual .env file — it's already in .gitignore.

# Flask
SECRET_KEY=change-this-to-a-random-string

# --- SMTP Email (for quote-request notifications to the CEO) ---
# These come from whoever hosts support@thebestestimatorllc.com's inbox.
#
# If using Google Workspace / Gmail:
#   MAIL_SERVER=smtp.gmail.com
#   MAIL_PORT=587
#   MAIL_USE_TLS=True
#   MAIL_USERNAME=support@thebestestimatorllc.com
#   MAIL_PASSWORD=<a 16-character Google "App Password", NOT your normal login password>
#   (Generate one at: https://myaccount.google.com/apppasswords — requires 2FA enabled)
#
# If using Microsoft 365 / Outlook:
#   MAIL_SERVER=smtp.office365.com
#   MAIL_PORT=587
#   MAIL_USE_TLS=True
#   MAIL_USERNAME=support@thebestestimatorllc.com
#   MAIL_PASSWORD=<your Microsoft account password or an app password if MFA is on>
#
# If using cPanel / generic hosting-provided email:
#   MAIL_SERVER=mail.thebestestimatorllc.com   (check your hosting control panel for the exact value)
#   MAIL_PORT=587
#   MAIL_USE_TLS=True
#   MAIL_USERNAME=support@thebestestimatorllc.com
#   MAIL_PASSWORD=<the mailbox password>

MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=support@thebestestimatorllc.com
MAIL_PASSWORD=

# Where quote-request notifications get sent (usually the same as MAIL_USERNAME)
CEO_EMAIL=support@thebestestimatorllc.com
